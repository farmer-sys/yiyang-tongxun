/* pages/about/about.wxss */
.page {
  padding-bottom: 20px;
  background: #f0f4f8;
  min-height: 100vh;
}
.section {
  background: #fff;
  border-radius: 16px;
  margin: 10px 16px;
  padding: 20px 16px;
}
.section-title {
  font-size: 16px;
  font-weight: 700;
  color: #003366;
  margin-bottom: 14px;
  display: flex;
  align-items: center;
  gap: 6px;
}
.title-icon { font-size: 18px; }

.about-header {
  text-align: center;
  padding: 10px 0;
}
.about-logo { margin-bottom: 10px; }
.about-name { font-size: 24px; font-weight: 900; color: #003366; display: block; }
.about-slogan { font-size: 14px; color: #888; margin-top: 4px; display: block; }

.about-text {
  font-size: 14px;
  color: #555;
  line-height: 1.8;
  display: block;
}

.contact-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px 0;
  border-bottom: 1px solid #f0f0f0;
}
.contact-item:last-child { border-bottom: none; }
.contact-icon { font-size: 22px; width: 36px; text-align: center; }
.contact-info { flex: 1; }
.contact-label { font-size: 12px; color: #999; display: block; }
.contact-value { font-size: 14px; color: #333; font-weight: 500; display: block; margin-top: 2px; }

.action-btns {
  margin: 16px;
  display: flex;
  gap: 10px;
}
.action-btn {
  flex: 1;
  border-radius: 12px;
  font-size: 15px;
  font-weight: 700;
  padding: 14px 0;
  margin: 0;
}
.call-btn { background: #27ae60; color: #fff; }
.booking-btn { background: #003366; color: #fff; }

.footer { text-align: center; padding: 20px; }
.footer-text { font-size: 11px; color: #999; }
