<view class="page">
  <view class="section">
    <view class="section-title">
      <text class="title-icon">🏷️</text>
      <text>合作品牌</text>
    </view>
    <view class="brand-grid">
      <view class="brand-item" wx:for="{{brands}}" wx:key="id">
        <text class="brand-name" style="color:{{item.color}}">{{item.name}}</text>
        <text class="brand-desc">{{item.desc}}</text>
      </view>
    </view>
  </view>

  <view class="brand-section" wx:for="{{products}}" wx:key="id">
    <view class="brand-header">
      <text class="brand-title" style="color:{{item.color}}">{{item.brand}}</text>
      <text class="brand-sub">{{item.sub}}</text>
    </view>
    <view class="product-card" wx:for="{{item.list}}" wx:for-item="p" wx:key="name">
      <view class="product-icon">{{p.icon}}</view>
      <view class="product-info">
        <text class="product-name">{{p.name}}</text>
        <text class="product-model">{{p.model}}</text>
        <text class="product-desc">{{p.desc}}</text>
        <view class="product-tags">
          <text class="mini-tag" wx:for="{{p.tags}}" wx:key="*this">{{item}}</text>
        </view>
      </view>
    </view>
  </view>
</view>