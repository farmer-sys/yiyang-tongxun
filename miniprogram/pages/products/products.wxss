.page{padding-bottom:20px;background:#f0f4f8;min-height:100vh}
.section{background:#fff;border-radius:16px;margin:10px 16px;padding:20px 16px}
.section-title{font-size:16px;font-weight:700;color:#003366;margin-bottom:14px;display:flex;align-items:center;gap:6px}
.title-icon{font-size:18px}
.brand-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.brand-item{text-align:center;padding:16px 8px;background:#f2f6fc;border-radius:12px}
.brand-name{font-size:16px;font-weight:800;display:block}
.brand-desc{font-size:11px;color:#888;margin-top:4px;display:block}
.brand-section{margin:0 16px 12px}
.brand-header{padding:16px 16px 12px;background:#fff;border-radius:16px 16px 0 0}
.brand-title{font-size:18px;font-weight:800;display:block}
.brand-sub{font-size:11px;color:#999;display:block;margin-top:2px}
.product-card{display:flex;gap:12px;background:#fff;border-top:1px solid #f0f0f0;padding:14px 16px}
.product-card:last-child{border-radius:0 0 16px 16px;margin-bottom:16px}
.product-icon{font-size:28px;width:44px;height:44px;background:#f2f6fc;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.product-info{flex:1}
.product-name{font-size:14px;font-weight:600;color:#1a2332;display:block}
.product-model{font-size:11px;color:#003366;font-weight:500;margin-top:1px;display:block}
.product-desc{font-size:12px;color:#666;margin-top:2px;display:block;line-height:1.5}
.product-tags{display:flex;gap:4px;flex-wrap:wrap;margin-top:4px}
.mini-tag{background:#e8f2ff;color:#004b99;padding:2px 8px;border-radius:8px;font-size:10px}