<!-- pages/index/index.wxml -->
<view class="page">
  <!-- 顶部Logo区 -->
  <view class="hero">
    <view class="logo-area">
      <view class="logo-icon">
        <image src="/images/home_active.png" mode="aspectFit" style="width:56px;height:56px;border-radius:50%"></image>
      </view>
      <text class="logo-text">怡阳通讯</text>
    </view>
    <view class="hero-tags">
      <text class="tag">安防监控</text>
      <text class="tag">网络全光</text>
      <text class="tag">客控声光</text>
    </view>
    <text class="hero-sub">弱电工程 · 专业施工 · 品牌授权</text>
    <text class="hero-phone" bindtap="callPhone">{{phone}}</text>
    <view class="hero-btns">
      <button class="btn-primary" bindtap="callPhone">📞 立即拨打</button>
      <button class="btn-secondary" bindtap="goBooking">📅 预约勘测</button>
    </view>
  </view>

  <!-- 服务项目 -->
  <view class="section">
    <view class="section-title">
      <text class="title-icon">📦</text>
      <text>服务项目</text>
    </view>
    <view class="service-grid">
      <view class="service-item" wx:for="{{services}}" wx:key="id" bindtap="goServiceDetail" data-id="{{item.id}}">
        <text class="service-icon">{{item.icon}}</text>
        <text class="service-name">{{item.name}}</text>
        <text class="service-desc">{{item.desc}}</text>
      </view>
    </view>
  </view>

  <!-- 重点项目 -->
  <view class="section">
    <view class="section-title">
      <text class="title-icon">🏆</text>
      <text>重点项目</text>
    </view>
    <view class="case-card" wx:for="{{cases}}" wx:key="id" catchtap="showCase" data-id="{{item.id}}">
      <view class="case-tag {{item.tagClass}}">{{item.tag}}</view>
      <view class="case-title">{{item.title}}</view>
      <view class="case-desc">{{item.desc}}</view>
      <view class="case-stats" wx:if="{{item.stats}}">
        <text wx:for="{{item.stats}}" wx:key="*this" class="stat-item">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 底部联系方式 -->
  <view class="footer">
    <text class="footer-phone" bindtap="callPhone">📞 {{phone}}</text>
    <text class="footer-addr">📍 赣州经济技术开发区和信广场D栋</text>
    <text class="footer-copy">© 怡阳通讯  All Rights Reserved</text>
  </view>

  <!-- 服务详情弹窗 -->
  <view class="modal-overlay {{showServiceDetail ? 'active' : ''}}" bindtap="hideServiceDetail">
    <view class="modal-box" catchtap="noop">
      <text class="modal-icon">{{currentService.icon}}</text>
      <text class="modal-title">{{currentService.name}}</text>
      <text class="modal-desc">{{currentService.detail}}</text>
      <view class="modal-actions">
        <button class="modal-btn" bindtap="callPhone">📞 咨询报价</button>
        <button class="modal-btn modal-btn-secondary" bindtap="hideServiceDetail">关闭</button>
      </view>
    </view>
  </view>
</view>
