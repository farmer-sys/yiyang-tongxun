<!-- pages/index/index.wxml -->
<view class="page">
  <!-- 椤堕儴Logo鍖?-->
  <view class="hero">
    <view class="logo-area">
      <view class="logo-icon">
        <svg viewBox="0 0 60 60" width="48" height="48">
          <circle cx="30" cy="30" r="29" fill="#002d5a"/>
          <circle cx="30" cy="30" r="27" fill="none" stroke="#f39c12" stroke-width="1.5" opacity="0.6"/>
          <path d="M30,12 L22,30 L22,46" stroke="#f39c12" stroke-width="2.8" fill="none" stroke-linecap="round" stroke-linejoin="round" opacity="0.8"/>
          <path d="M30,12 L38,30 L38,46" stroke="#f39c12" stroke-width="2.8" fill="none" stroke-linecap="round" stroke-linejoin="round" opacity="0.8"/>
          <path d="M30,12 L30,46" stroke="#fff" stroke-width="1.5" fill="none" opacity="0.6"/>
          <rect x="22" y="50" width="16" height="2.5" rx="1.25" fill="#f39c12" opacity="0.6"/>
        </svg>
      </view>
      <text class="logo-text">鎬￠槼閫氳</text>
    </view>
    <view class="hero-tags">
      <text class="tag">瀹夐槻鐩戞帶</text>
      <text class="tag">缃戠粶鍏ㄥ厜</text>
      <text class="tag">瀹㈡帶澹板厜</text>
    </view>
    <text class="hero-sub">寮辩數宸ョ▼ 路 涓撲笟鏂藉伐 路 鍝佺墝鎺堟潈</text>
    <text class="hero-phone" bindtap="callPhone">{{phone}}</text>
    <view class="hero-btns">
      <button class="btn-primary" bindtap="callPhone">馃摓 绔嬪嵆鎷ㄦ墦</button>
      <button class="btn-secondary" bindtap="goBooking">馃搮 棰勭害鍕樻祴</button>
    </view>
  </view>

  <!-- 鏈嶅姟椤圭洰 -->
  <view class="section">
    <view class="section-title">
      <text class="title-icon">馃摝</text>
      <text>鏈嶅姟椤圭洰</text>
    </view>
    <view class="service-grid">
      <view class="service-item" wx:for="{{services}}" wx:key="id" catchtap="showService" data-id="{{item.id}}">
        <text class="service-icon">{{item.icon}}</text>
        <text class="service-name">{{item.name}}</text>
        <text class="service-desc">{{item.desc}}</text>
      </view>
    </view>
  </view>

  <!-- 閲嶇偣椤圭洰 -->
  <view class="section">
    <view class="section-title">
      <text class="title-icon">馃弳</text>
      <text>閲嶇偣椤圭洰</text>
    </view>
    <view class="case-card" wx:for="{{cases}}" wx:key="id" catchtap="showCase" data-id="{{item.id}}">
      <view class="case-tag {{item.tagClass}}">{{item.tag}}</view>
      <view class="case-title">{{item.title}}</view>
      <view class="case-desc">{{item.desc}}</view>
      <view class="case-stats" wx:if="{{item.stats}}">
        <text wx:for="{{item.stats}}" wx:key="*this" class="stat-item">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 搴曢儴鑱旂郴鏂瑰紡 -->
  <view class="footer">
    <text class="footer-phone" bindtap="callPhone">馃摓 {{phone}}</text>
    <text class="footer-addr">馃搷 璧ｅ窞缁忔祹鎶€鏈紑鍙戝尯鍜屼俊骞垮満D鏍?/text>
    <text class="footer-copy">漏 鎬￠槼閫氳  All Rights Reserved</text>
  </view>

  <!-- 鏈嶅姟璇︽儏寮圭獥 -->
  <view class="modal-overlay {{showServiceDetail ? 'active' : ''}}" bindtap="hideServiceDetail">
    <view class="modal-box" catchtap="noop">
      <text class="modal-icon">{{currentService.icon}}</text>
      <text class="modal-title">{{currentService.name}}</text>
      <text class="modal-desc">{{currentService.detail}}</text>
      <view class="modal-actions">
        <button class="modal-btn" bindtap="callPhone">馃摓 鍜ㄨ鎶ヤ环</button>
        <button class="modal-btn modal-btn-secondary" bindtap="hideServiceDetail">鍏抽棴</button>
      </view>
    </view>
  </view>
</view>
